+/* Debug trace of frame assembly: env LIBUVC_TRACE=1 logs every assembled frame size,
+   LIBUVC_TRACE=2 additionally logs every isochronous packet. */
+static int _uvc_trace_enabled(void) {
+  static int enabled = -1;
+  if (enabled < 0) {
+    const char *v = getenv("LIBUVC_TRACE");
+    enabled = v ? atoi(v) : 0;
+  }
+  return enabled;
+}
